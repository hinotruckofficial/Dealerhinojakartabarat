.testimonial-slider {
  max-width: 900px;
  margin: 60px auto;
  text-align: center;
  font-family: 'Poppins', sans-serif;
  position: relative;
}

.section-title {
  margin-bottom: 25px;
  font-size: 28px;
  color: #0a1950;
}

/* VIEWPORT (AREA TERLIHAT) */
.viewport {
  overflow: hidden;
  position: relative;
}

/* CONTAINER GESER */
.slides {
  display: flex;
  transition: transform 0.6s ease;
}

/* ITEM */
.testimonial-item {
  min-width: 100%;
  padding: 10px 40px;
  box-sizing: border-box;
}

.testimonial-item p {
  font-size: 17px;
  font-style: italic;
  color: #333;
  line-height: 1.6;
}

.testimonial-item h4 {
  margin-top: 10px;
  font-size: 15px;
  color: #0a1950;
}

/* BINTANG */
.stars {
  color: #f5b301;
  font-size: 18px;
  margin: 8px 0;
}

/* DOT */
.controls {
  margin-top: 15px;
}

.dot {
  height: 10px;
  width: 10px;
  margin: 5px;
  background-color: #ccc;
  border-radius: 50%;
  display: inline-block;
  cursor: pointer;
  transition: 0.3s;
}

.dot.active {
  background-color: #0a1950;
  transform: scale(1.2);
}
